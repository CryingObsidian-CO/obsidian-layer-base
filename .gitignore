# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Built from mcp/, so it is generated the same way as main.js.
mcp-server.cjs

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local environment and key material: never commit it. `.env.example` is the one
# that belongs in the repository, because it says what the variables are without
# carrying their values.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

.agent-teams
.dsh-**
