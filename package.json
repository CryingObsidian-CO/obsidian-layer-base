{
	"name": "obsidian-layer-base",
	"version": "0.1.0",
	"description": "Multi-dimensional board and table views stored in self-contained .layer files.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"lint": "eslint .",
		"verify:css": "node scripts/verify-css-vars.mjs",
		"check:i18n": "node scripts/check-i18n.mjs"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^7.3.7",
		"vitest": "^5.0.4"
	}
}
