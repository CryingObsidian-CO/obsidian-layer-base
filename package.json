{
  "name": "layer-base",
  "version": "0.1.2",
  "description": "Multi-dimensional tables in self-contained .layer files: 16 column types, formulas, relations and rollups.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "lint": "eslint .",
    "verify:css": "node scripts/verify-css-vars.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "verify": "npm run lint && npm run check:i18n && npm run verify:css && npm run check:version && npm test",
    "build:mcp": "esbuild mcp/server.ts --bundle --outfile=mcp-server.cjs --format=cjs --target=node18 --platform=node"
  },
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
